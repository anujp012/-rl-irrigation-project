# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
env/
.venv/

# Training outputs -- these get regenerated by running train_dqn.py,
# no need to version them (and they'll cause merge conflicts if two
# people train at the same time)
checkpoints/
logs/

# Dataset -- Kaggle datasets often restrict redistribution, and it's
# not code, so keep it out of git. Add a note in README telling your
# friend where to download it instead (see below).
data/*.csv

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db